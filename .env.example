# ====================
# LLM Configuration
# ====================
# Options: "openai" or "groq"
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Provider credentials are placeholders only.
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=
LLM_API_KEY=

# ====================
# API Configuration
# ====================
API_PORT=8000

# ====================
# Database Configuration
# ====================
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=password
POSTGRES_DB=agent_db
DATABASE_URL=postgresql+asyncpg://agent_user:password@db:5432/agent_db

# ====================
# Redis Configuration
# ====================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# API protection
TASK_RATE_LIMIT_REQUESTS=30
TASK_RATE_LIMIT_WINDOW_SECONDS=60
TASK_IDEMPOTENCY_TTL_SECONDS=86400
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_TOKENS=5000
CELERY_TASK_TIMEOUT_SECONDS=900
CELERY_TASK_SOFT_TIMEOUT_SECONDS=840

# ====================
# Tool Configuration (Phase 2)
# ====================
# Options: "llm_research" (default), "web_search", "tavily_search"
RESEARCH_TOOL=llm_research